{
  "name": "cctrack",
  "version": "0.1.0",
  "description": "See how many Claude Code sessions you run, how many are actually working, and how long they live.",
  "keywords": [
    "claude",
    "claude-code",
    "sessions",
    "dashboard",
    "stats",
    "cli"
  ],
  "homepage": "https://github.com/al-muammar/cctrack#readme",
  "bugs": "https://github.com/al-muammar/cctrack/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/al-muammar/cctrack.git"
  },
  "license": "MIT",
  "author": "al-muammar",
  "type": "module",
  "bin": {
    "cctrack": "bin/cctrack.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "pretest": "npm run build",
    "start": "npm run build && node bin/cctrack.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
